---
import { countEntries } from '@/lib/content-utils'
import type { Layer } from '@/lib/content-utils'

interface Props {
  id: string
  title: string
  description?: string
  estimatedRuntime?: string
  structure: Layer[]
  href: string
  tags?: string[]
}

const {
  id: _id,
  title,
  description,
  estimatedRuntime,
  structure,
  href,
  tags,
} = Astro.props

const entryCount = countEntries(structure)
---

<a
  href={href}
  class="group bg-elevated hover:bg-hover hover:glow-cyan block rounded-xl p-5 transition-all"
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <h3 class="truncate text-lg font-semibold group-hover:text-[var(--cyan)]">
        {title}
      </h3>
      {
        description && (
          <p class="text-muted-foreground mt-1 line-clamp-2 text-sm">
            {description}
          </p>
        )
      }
    </div>
    {
      tags && tags.length > 0 && (
        <div class="flex flex-shrink-0 gap-1">
          {tags.slice(0, 2).map((tag) => (
            <span class="bg-muted text-muted-foreground rounded-full px-2 py-0.5 text-xs font-medium">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>

  <div
    class="text-muted-foreground mt-3 flex items-center gap-4 font-mono text-sm"
  >
    <span>{entryCount} entries</span>
    {estimatedRuntime && <span>• {estimatedRuntime}</span>}
  </div>

  <div class="mt-4">
    <slot />
  </div>
</a>

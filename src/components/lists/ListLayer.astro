---
import { ExpandableEntryCard } from '@/components/cards/ExpandableEntryCard'
import ProgressToggle from '@/components/tracking/ProgressToggle'
import type { Layer, EntryData } from '@/lib/content-utils'

interface Props {
  layer: Layer
  entryMap: Map<string, EntryData>
  fandomId: string
  depth?: number
}

const { layer, entryMap, fandomId, depth = 0 } = Astro.props

// Depth-based accent colors for Ship's Computer aesthetic
const depthAccents = [
  'border-[var(--magenta)]/40',
  'border-[var(--cyan)]/40',
  'border-[var(--purple)]/40',
  'border-[var(--gold)]/40',
]

const depthTextColors = [
  'text-[var(--magenta)]',
  'text-[var(--cyan)]',
  'text-[var(--purple)]',
  'text-[var(--gold)]',
]

const borderStyle = layer.title
  ? `border-l-2 ${depthAccents[depth % depthAccents.length]}`
  : ''
const accentColor = depthTextColors[depth % depthTextColors.length]
---

<div class:list={['space-y-3', { 'pl-4': depth > 0 }]}>
  {
    layer.title && (
      <div class:list={['py-3 pl-4', borderStyle]}>
        <div class="flex items-center gap-3">
          <span
            class:list={[
              'font-mono text-[10px] tracking-widest opacity-60',
              accentColor,
            ]}
          >
            {depth === 0 ? 'SECTION' : depth === 1 ? 'ARC' : 'PHASE'}
          </span>
          <div
            class:list={[
              'h-px flex-1 opacity-20',
              depth === 0
                ? 'bg-[var(--magenta)]'
                : depth === 1
                  ? 'bg-[var(--cyan)]'
                  : 'bg-[var(--purple)]',
            ]}
          />
        </div>
        <h3
          class:list={[
            'mt-1 font-serif font-bold tracking-wider uppercase',
            depth === 0 ? 'text-xl' : depth === 1 ? 'text-lg' : 'text-base',
          ]}
        >
          {layer.title}
        </h3>
        {layer.description && (
          <p class="mt-2 text-sm text-[var(--muted-foreground)]">
            {layer.description}
          </p>
        )}
      </div>
    )
  }

  {
    layer.entries && layer.entries.length > 0 && (
      <div class="space-y-2">
        {layer.entries.map((entryId) => {
          const entry = entryMap.get(entryId)
          if (!entry) {
            console.warn(`Entry not found: ${entryId}`)
            return (
              <div class="bg-destructive/10 border-destructive/30 rounded-lg border p-3 text-sm">
                <span class="text-destructive font-medium">Missing entry:</span>
                <code class="text-muted-foreground ml-2 font-mono text-xs">
                  {entryId}
                </code>
              </div>
            )
          }
          return (
            <ExpandableEntryCard
              client:visible
              id={entry.id}
              title={entry.title}
              type={entry.type}
              releaseDate={entry.releaseDate}
              description={entry.description}
              runtime={entry.runtime}
              seasonNumber={entry.seasonNumber}
              episodeNumber={entry.episodeNumber}
              showTitle={entry.showTitle}
              links={entry.links}
              directors={entry.directors}
              authors={entry.authors}
              rating={entry.rating}
              compact
            >
              <ProgressToggle
                client:visible
                entryId={entry.id}
                fandomId={fandomId}
              />
            </ExpandableEntryCard>
          )
        })}
      </div>
    )
  }

  {
    layer.children &&
      (layer.children as Layer[]).map((child) => (
        <Astro.self
          layer={child}
          entryMap={entryMap}
          fandomId={fandomId}
          depth={depth + 1}
        />
      ))
  }
</div>

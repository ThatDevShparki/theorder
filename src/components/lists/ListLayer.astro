---
import { ExpandableEntryCard } from '@/components/cards/ExpandableEntryCard'
import ProgressToggle from '@/components/tracking/ProgressToggle'
import type { Layer, EntryData } from '@/lib/content-utils'

interface Props {
  layer: Layer
  entryMap: Map<string, EntryData>
  fandomId: string
  depth?: number
}

const { layer, entryMap, fandomId, depth = 0 } = Astro.props

// Depth-based styling - no indentation, use color/size to show hierarchy
const depthConfig = [
  {
    label: 'SECTION',
    color: 'var(--magenta)',
    titleSize: 'text-xl',
    bgOpacity: 'bg-[var(--magenta)]/5',
    borderColor: 'border-[var(--magenta)]/30',
  },
  {
    label: 'ARC',
    color: 'var(--cyan)',
    titleSize: 'text-lg',
    bgOpacity: 'bg-[var(--cyan)]/5',
    borderColor: 'border-[var(--cyan)]/30',
  },
  {
    label: 'PHASE',
    color: 'var(--purple)',
    titleSize: 'text-base',
    bgOpacity: 'bg-[var(--purple)]/5',
    borderColor: 'border-[var(--purple)]/30',
  },
  {
    label: 'PART',
    color: 'var(--gold)',
    titleSize: 'text-base',
    bgOpacity: 'bg-[var(--gold)]/5',
    borderColor: 'border-[var(--gold)]/30',
  },
]

const config = depthConfig[depth % depthConfig.length]
---

<div class="space-y-4">
  {
    layer.title && (
      <div
        class:list={[
          'rounded-lg border p-4',
          config.bgOpacity,
          config.borderColor,
        ]}
      >
        {/* Header row with label and line */}
        <div class="mb-2 flex items-center gap-3">
          <span
            class="rounded px-2 py-0.5 font-mono text-[10px] tracking-widest"
            style={`background: ${config.color}20; color: ${config.color};`}
          >
            {config.label}
          </span>
          <div
            class="h-px flex-1"
            style={`background: linear-gradient(to right, ${config.color}40, transparent);`}
          />
        </div>

        {/* Title */}
        <h3
          class:list={[
            'font-serif font-bold tracking-wider uppercase',
            config.titleSize,
          ]}
        >
          {layer.title}
        </h3>

        {/* Description */}
        {layer.description && (
          <p class="mt-2 text-sm text-[var(--muted-foreground)]">
            {layer.description}
          </p>
        )}
      </div>
    )
  }

  {
    layer.entries && layer.entries.length > 0 && (
      <div class="flex flex-col gap-4">
        {layer.entries.map((entryId) => {
          const entry = entryMap.get(entryId)
          if (!entry) {
            console.warn(`Entry not found: ${entryId}`)
            return (
              <div class="rounded-lg border border-[var(--destructive)]/30 bg-[var(--destructive)]/10 p-3 text-sm">
                <span class="font-medium text-[var(--destructive)]">
                  Missing entry:
                </span>
                <code class="ml-2 font-mono text-xs text-[var(--muted-foreground)]">
                  {entryId}
                </code>
              </div>
            )
          }
          return (
            <ExpandableEntryCard
              client:visible
              id={entry.id}
              title={entry.title}
              type={entry.type}
              releaseDate={entry.releaseDate}
              description={entry.description}
              runtime={entry.runtime}
              seasonNumber={entry.seasonNumber}
              episodeNumber={entry.episodeNumber}
              showTitle={entry.showTitle}
              links={entry.links}
              directors={entry.directors}
              authors={entry.authors}
              rating={entry.rating}
              compact
            >
              <ProgressToggle
                client:visible
                entryId={entry.id}
                fandomId={fandomId}
              />
            </ExpandableEntryCard>
          )
        })}
      </div>
    )
  }

  {
    layer.children &&
      (layer.children as Layer[]).map((child) => (
        <Astro.self
          layer={child}
          entryMap={entryMap}
          fandomId={fandomId}
          depth={depth + 1}
        />
      ))
  }
</div>

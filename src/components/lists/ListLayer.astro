---
import { ExpandableEntryCard } from '@/components/cards/ExpandableEntryCard'
import ProgressToggle from '@/components/tracking/ProgressToggle'
import type { Layer, EntryData } from '@/lib/content-utils'

interface Props {
  layer: Layer
  entryMap: Map<string, EntryData>
  fandomId: string
  depth?: number
}

const { layer, entryMap, fandomId, depth = 0 } = Astro.props

// Depth-based styling
const depthStyles = [
  'border-l-4 border-[var(--magenta)]/50',
  'border-l-4 border-[var(--cyan)]/50',
  'border-l-4 border-[var(--purple)]/50',
  'border-l-4 border-[var(--gold)]/50',
]

const borderStyle = layer.title ? depthStyles[depth % depthStyles.length] : ''
---

<div class:list={['space-y-3', { 'pl-4': depth > 0 }]}>
  {
    layer.title && (
      <div class:list={['py-2 pl-4', borderStyle]}>
        <h3
          class:list={[
            'font-semibold',
            depth === 0 ? 'text-xl' : depth === 1 ? 'text-lg' : 'text-base',
          ]}
        >
          {layer.title}
        </h3>
        {layer.description && (
          <p class="text-muted-foreground mt-1 text-sm">{layer.description}</p>
        )}
      </div>
    )
  }

  {
    layer.entries && layer.entries.length > 0 && (
      <div class="space-y-2">
        {layer.entries.map((entryId) => {
          const entry = entryMap.get(entryId)
          if (!entry) {
            console.warn(`Entry not found: ${entryId}`)
            return (
              <div class="bg-destructive/10 border-destructive/30 rounded-lg border p-3 text-sm">
                <span class="text-destructive font-medium">Missing entry:</span>
                <code class="text-muted-foreground ml-2 font-mono text-xs">
                  {entryId}
                </code>
              </div>
            )
          }
          return (
            <ExpandableEntryCard
              client:visible
              id={entry.id}
              title={entry.title}
              type={entry.type}
              releaseDate={entry.releaseDate}
              description={entry.description}
              runtime={entry.runtime}
              seasonNumber={entry.seasonNumber}
              episodeNumber={entry.episodeNumber}
              showTitle={entry.showTitle}
              links={entry.links}
              directors={entry.directors}
              authors={entry.authors}
              rating={entry.rating}
              compact
            >
              <ProgressToggle
                client:visible
                entryId={entry.id}
                fandomId={fandomId}
              />
            </ExpandableEntryCard>
          )
        })}
      </div>
    )
  }

  {
    layer.children &&
      (layer.children as Layer[]).map((child) => (
        <Astro.self
          layer={child}
          entryMap={entryMap}
          fandomId={fandomId}
          depth={depth + 1}
        />
      ))
  }
</div>

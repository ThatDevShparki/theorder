---
interface Props {
  currentPath?: string
}

const { currentPath = '' } = Astro.props

const navLinks = [
  { href: '/', label: 'Browse', code: 'NAV.01' },
  { href: '/dashboard', label: 'Dashboard', code: 'NAV.02' },
]
---

<header
  class="border-border/50 bg-background/95 sticky top-0 z-50 border-b backdrop-blur-sm"
>
  {/* Top accent line */}
  <div
    class="h-0.5 bg-gradient-to-r from-transparent via-[var(--cyan)] to-transparent opacity-40"
  >
  </div>

  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-3 py-2 sm:px-4 sm:py-3"
  >
    <a href="/" class="group flex items-center gap-2 sm:gap-3">
      {/* Geometric Command Logo Mark - Hexagonal insignia */}
      <div class="relative flex size-10 items-center justify-center sm:size-11">
        <svg
          viewBox="0 0 40 40"
          fill="none"
          class="absolute inset-0 size-full transition-transform duration-300 group-hover:scale-105"
        >
          {/* Outer hexagon frame */}
          <path
            d="M20 2 L36 11 L36 29 L20 38 L4 29 L4 11 Z"
            stroke="var(--cyan)"
            stroke-width="1.5"
            fill="none"
            class="opacity-60 transition-opacity group-hover:opacity-100"
          ></path>
          {/* Inner chevron pointing up - symbolizing "order" / ascending */}
          <path
            d="M12 24 L20 14 L28 24"
            stroke="var(--cyan)"
            stroke-width="2.5"
            stroke-linecap="square"
            fill="none"
            class="transition-all group-hover:stroke-[var(--magenta)]"></path>
          {/* Horizontal bar - stability / structure */}
          <path
            d="M12 28 L28 28"
            stroke="var(--cyan)"
            stroke-width="2"
            stroke-linecap="square"
            class="opacity-40"></path>
        </svg>
      </div>
      {/* Logo text */}
      <div class="flex flex-col">
        <span
          class="font-serif text-base font-bold tracking-[0.12em] whitespace-nowrap uppercase sm:text-xl sm:tracking-[0.15em]"
        >
          The Order
        </span>
        {/* Subheading - hidden on mobile */}
        <span
          class="text-muted-foreground hidden font-mono text-[9px] tracking-[0.2em] uppercase sm:block"
        >
          Canon Tracking System
        </span>
      </div>
    </a>

    <div class="flex items-center">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'group relative px-3 py-2 font-mono text-sm tracking-wide transition-all sm:px-4',
              currentPath === link.href
                ? 'text-accent'
                : 'text-muted-foreground hover:text-foreground',
            ]}
          >
            {/* Nav codes - hidden on mobile */}
            <span class="text-accent/50 mr-2 hidden text-xs sm:inline">
              {link.code}
            </span>
            {link.label}
            {/* Active indicator */}
            {currentPath === link.href && (
              <span class="bg-accent absolute bottom-0 left-1/2 h-0.5 w-8 -translate-x-1/2 rounded-full" />
            )}
            {/* Hover indicator */}
            <span class="bg-accent/0 group-hover:bg-accent/30 absolute bottom-0 left-1/2 h-0.5 w-0 -translate-x-1/2 rounded-full transition-all group-hover:w-8" />
          </a>
        ))
      }
    </div>
  </nav>
</header>

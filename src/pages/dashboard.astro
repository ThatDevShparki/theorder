---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/main.astro'
import Header from '@/components/navigation/Header.astro'
import DbStatusBanner from '@/components/status/DbStatusBanner'
import DashboardContent from '@/components/dashboard/DashboardContent'

// Get all fandoms, lists, and entries at build time
const fandomsCollection = await getCollection('fandoms')
const listsCollection = await getCollection('lists')
const entriesCollection = await getCollection('entries')

// Transform to props for the dashboard component
const allFandoms = fandomsCollection.map((f) => ({
  id: f.data.id,
  name: f.data.name,
  description: f.data.description,
}))

const allLists = listsCollection.map((l) => {
  // Extract fandom ID from the collection ID (e.g., "star-wars/lists/chronological")
  const fandomId = l.id.split('/')[0]
  return {
    id: l.data.id,
    title: l.data.title,
    fandomId,
    structure: l.data.structure,
  }
})

// Build entry lookup map with essential display data
const allEntries = Object.fromEntries(
  entriesCollection.map((e) => [
    e.data.id,
    {
      id: e.data.id,
      title: e.data.title,
      type: e.data.type,
      seasonNumber: e.data.seasonNumber,
      episodeNumber: e.data.episodeNumber,
      showTitle: e.data.showTitle,
      runtime: e.data.runtime,
    },
  ])
)

const currentDate = new Date().toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
})
---

<Layout title="The Order | Dashboard">
  <DbStatusBanner client:load />
  <Header currentPath="/dashboard" />

  <main class="relative min-h-screen">
    {/* Background grid */}
    <div class="grid-pattern pointer-events-none absolute inset-0 opacity-30">
    </div>

    <div class="relative mx-auto max-w-4xl px-4 py-8">
      {/* Dashboard header */}
      <header class="mb-10">
        <div class="flex items-center gap-4">
          <div
            class="h-px flex-1 bg-gradient-to-r from-[var(--cyan)]/30 to-transparent"
          >
          </div>
          <span
            class="text-muted-foreground font-mono text-[10px] tracking-widest"
            >MISSION CONTROL</span
          >
          <div
            class="h-px flex-1 bg-gradient-to-l from-[var(--cyan)]/30 to-transparent"
          >
          </div>
        </div>

        <div class="mt-6 flex items-end justify-between">
          <div>
            <h1
              class="font-serif text-4xl font-bold tracking-[0.1em] uppercase md:text-5xl"
            >
              Your Journey
            </h1>
            <p class="text-muted-foreground mt-3 text-base">
              Active mission status and progress tracking
            </p>
          </div>
          <div class="hidden text-right md:block">
            <p class="text-accent font-mono text-xs tracking-wider">STARDATE</p>
            <p class="text-foreground font-mono text-sm">{currentDate}</p>
          </div>
        </div>

        <div
          class="mt-6 h-px bg-gradient-to-r from-[var(--magenta)]/50 via-transparent to-[var(--cyan)]/50"
        >
        </div>
      </header>

      <DashboardContent
        client:load
        allFandoms={allFandoms}
        allLists={allLists}
        allEntries={allEntries}
      />
    </div>
  </main>
</Layout>

---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/main.astro'
import Header from '@/components/navigation/Header.astro'
import DbStatusBanner from '@/components/status/DbStatusBanner'
import ListCard from '@/components/cards/ListCard.astro'
import ListProgressBar from '@/components/tracking/ListProgressBar'
import FavoriteButton from '@/components/favorites/FavoriteButton'
import { flattenEntries, createListId } from '@/lib/content-utils'

export async function getStaticPaths() {
  const fandoms = await getCollection('fandoms')

  return fandoms.map((fandom) => ({
    params: { slug: fandom.data.id },
    props: { fandom },
  }))
}

const { fandom } = Astro.props
const fandomId = fandom.data.id

// Get lists for this fandom
const allLists = await getCollection('lists')
const fandomLists = allLists.filter((l) => l.id.startsWith(fandomId + '/'))

// Get entries for this fandom (for stats)
const allEntries = await getCollection('entries')
const fandomEntries = allEntries.filter((e) => e.id.startsWith(fandomId + '/'))
---

<Layout title={`The Order | ${fandom.data.name}`}>
  <DbStatusBanner client:load />
  <Header />

  <main class="mx-auto max-w-4xl px-4 py-8">
    {/* Breadcrumb */}
    <nav aria-label="Breadcrumb" class="text-muted-foreground mb-6 text-sm">
      <a href="/" class="hover:text-foreground transition-colors">Browse</a>
      <span class="mx-2">→</span>
      <span class="text-foreground">{fandom.data.name}</span>
    </nav>

    {/* Fandom Header */}
    <header class="mb-8">
      <div class="flex items-start justify-between gap-4">
        <h1 class="font-serif text-4xl font-semibold tracking-wider">
          {fandom.data.name}
        </h1>
        <FavoriteButton
          client:visible
          type="fandom"
          itemId={fandomId}
          variant="icon"
          className="mt-2"
        />
      </div>
      {
        fandom.data.description && (
          <p class="text-muted-foreground mt-3 text-lg">
            {fandom.data.description}
          </p>
        )
      }
      <div
        class="text-muted-foreground mt-4 flex items-center gap-4 font-mono text-sm"
      >
        <span>{fandomEntries.length} entries</span>
        <span>•</span>
        <span>{fandomLists.length} lists</span>
      </div>
    </header>

    {/* External Links */}
    {
      fandom.data.links && fandom.data.links.length > 0 && (
        <div class="mb-8 flex flex-wrap gap-2">
          {fandom.data.links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-elevated hover:bg-hover hover:text-accent rounded-lg px-4 py-2 text-sm font-medium transition-colors"
            >
              {link.label} ↗
            </a>
          ))}
        </div>
      )
    }

    {/* Lists Section */}
    <section>
      <h2 class="mb-4 font-serif text-xl font-semibold tracking-wide">
        Choose Your Order
      </h2>

      {
        fandomLists.length === 0 ? (
          <div class="bg-elevated text-muted-foreground rounded-xl p-6 text-center">
            No lists available yet. Check back soon!
          </div>
        ) : (
          <div class="space-y-4">
            {fandomLists.map((list) => {
              const listId = createListId(fandomId, list.data.id)
              const entryIds = flattenEntries(list.data.structure)

              return (
                <ListCard
                  id={list.data.id}
                  title={list.data.title}
                  description={list.data.description}
                  estimatedRuntime={list.data.estimatedRuntime}
                  structure={list.data.structure}
                  href={`/fandom/${fandomId}/list/${list.data.id}`}
                  tags={list.data.tags}
                >
                  <ListProgressBar
                    client:visible
                    listId={listId}
                    entryIds={entryIds}
                    fandomId={fandomId}
                  />
                </ListCard>
              )
            })}
          </div>
        )
      }
    </section>
  </main>
</Layout>

---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/main.astro'
import Header from '@/components/navigation/Header.astro'
import DbStatusBanner from '@/components/status/DbStatusBanner'
import ListCard from '@/components/cards/ListCard.astro'
import ListProgressBar from '@/components/tracking/ListProgressBar'
import FavoriteButton from '@/components/favorites/FavoriteButton'
import { flattenEntries, createListId } from '@/lib/content-utils'

export async function getStaticPaths() {
  const fandoms = await getCollection('fandoms')

  return fandoms.map((fandom) => ({
    params: { slug: fandom.data.id },
    props: { fandom },
  }))
}

const { fandom } = Astro.props
const fandomId = fandom.data.id

// Get lists for this fandom
const allLists = await getCollection('lists')
const fandomLists = allLists.filter((l) => l.id.startsWith(fandomId + '/'))

// Get entries for this fandom (for stats)
const allEntries = await getCollection('entries')
const fandomEntries = allEntries.filter((e) => e.id.startsWith(fandomId + '/'))
---

<Layout title={`The Order | ${fandom.data.name}`}>
  <DbStatusBanner client:load />
  <Header />

  <main class="relative min-h-screen">
    {/* Background grid */}
    <div class="grid-pattern pointer-events-none absolute inset-0 opacity-30">
    </div>

    <div class="relative mx-auto max-w-4xl px-3 py-4 sm:px-4 sm:py-8">
      {/* Breadcrumb */}
      <nav
        aria-label="Breadcrumb"
        class="mb-4 flex items-center gap-1.5 font-mono text-[10px] tracking-wider sm:mb-6 sm:gap-2 sm:text-xs"
      >
        <a
          href="/"
          class="text-[var(--muted-foreground)] transition-colors hover:text-[var(--accent)]"
          >ARCHIVES</a
        >
        <span class="text-[var(--cyan)]/50">→</span>
        <span class="text-[var(--accent)]"
          >{fandom.data.name.toUpperCase()}</span
        >
      </nav>

      {/* Fandom Header */}
      <header class="mb-6 sm:mb-10">
        <div
          class="h-px bg-gradient-to-r from-[var(--cyan)]/30 via-transparent to-transparent"
        >
        </div>

        <div
          class="mt-4 flex items-start justify-between gap-3 sm:mt-6 sm:gap-4"
        >
          <div>
            <p
              class="mb-1 font-mono text-[9px] tracking-[0.2em] text-[var(--cyan)]/60 sm:mb-2 sm:text-[10px]"
            >
              ARCHIVE.{fandomId.toUpperCase().slice(0, 3)}
            </p>
            <h1
              class="font-serif text-3xl font-bold tracking-[0.1em] uppercase sm:text-4xl md:text-5xl"
            >
              {fandom.data.name}
            </h1>
          </div>
          <FavoriteButton
            client:visible
            type="fandom"
            itemId={fandomId}
            variant="icon"
            className="mt-1 sm:mt-2"
          />
        </div>

        {
          fandom.data.description && (
            <p class="mt-3 max-w-2xl text-sm text-[var(--muted-foreground)] sm:mt-4 sm:text-base">
              {fandom.data.description}
            </p>
          )
        }

        <div
          class="mt-4 flex items-center gap-4 font-mono text-[11px] tracking-wider sm:mt-6 sm:gap-6 sm:text-xs"
        >
          <span class="text-[var(--muted-foreground)]">
            <span class="text-[var(--accent)]">{fandomEntries.length}</span>
            <span class="ml-1 opacity-60">ENTRIES</span>
          </span>
          <span class="text-[var(--cyan)]/30">│</span>
          <span class="text-[var(--muted-foreground)]">
            <span class="text-[var(--accent)]">{fandomLists.length}</span>
            <span class="ml-1 opacity-60">LISTS</span>
          </span>
        </div>

        <div
          class="mt-4 h-px bg-gradient-to-r from-[var(--magenta)]/30 via-transparent to-[var(--cyan)]/30 sm:mt-6"
        >
        </div>
      </header>

      {/* External Links */}
      {
        fandom.data.links && fandom.data.links.length > 0 && (
          <div class="mb-8 flex flex-wrap gap-2">
            {fandom.data.links.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded border border-[var(--cyan)]/20 bg-[var(--background-elevated)] px-4 py-2 font-mono text-xs tracking-wider text-[var(--muted-foreground)] transition-all hover:border-[var(--cyan)]/50 hover:text-[var(--accent)]"
              >
                {link.label}
                <span class="ml-1 text-[var(--cyan)]/50">↗</span>
              </a>
            ))}
          </div>
        )
      }

      {/* Lists Section */}
      <section>
        <div class="mb-6 flex items-center gap-4">
          <div
            class="h-px flex-1 bg-gradient-to-r from-[var(--cyan)]/20 to-transparent"
          >
          </div>
          <h2
            class="font-mono text-xs tracking-[0.2em] text-[var(--muted-foreground)]"
          >
            AVAILABLE ORDERS
          </h2>
          <div
            class="h-px flex-1 bg-gradient-to-l from-[var(--cyan)]/20 to-transparent"
          >
          </div>
        </div>

        {
          fandomLists.length === 0 ? (
            <div class="rounded-lg border border-[var(--cyan)]/20 bg-[var(--background-elevated)] p-8 text-center">
              <p class="font-mono text-sm text-[var(--muted-foreground)]">
                No lists available yet. Check back soon.
              </p>
            </div>
          ) : (
            <div class="space-y-4">
              {fandomLists.map((list) => {
                const listId = createListId(fandomId, list.data.id)
                const entryIds = flattenEntries(list.data.structure)

                return (
                  <ListCard
                    id={list.data.id}
                    title={list.data.title}
                    description={list.data.description}
                    estimatedRuntime={list.data.estimatedRuntime}
                    structure={list.data.structure}
                    href={`/fandom/${fandomId}/list/${list.data.id}`}
                    tags={list.data.tags}
                  >
                    <ListProgressBar
                      client:visible
                      listId={listId}
                      entryIds={entryIds}
                      fandomId={fandomId}
                    />
                  </ListCard>
                )
              })}
            </div>
          )
        }
      </section>
    </div>
  </main>
</Layout>

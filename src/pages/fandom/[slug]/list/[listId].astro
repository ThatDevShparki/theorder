---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/main.astro'
import Header from '@/components/navigation/Header.astro'
import DbStatusBanner from '@/components/status/DbStatusBanner'
import ListLayer from '@/components/lists/ListLayer.astro'
import ListProgressBar from '@/components/tracking/ListProgressBar'
import FavoriteButton from '@/components/favorites/FavoriteButton'
import {
  flattenEntries,
  createListId,
  type EntryData,
} from '@/lib/content-utils'

export async function getStaticPaths() {
  const lists = await getCollection('lists')

  return lists.map((list) => {
    // Extract fandom slug from the collection ID (e.g., "star-wars/lists/chronological")
    const fandomSlug = list.id.split('/')[0]

    return {
      params: {
        slug: fandomSlug,
        listId: list.data.id,
      },
      props: { list, fandomSlug },
    }
  })
}

const { list, fandomSlug } = Astro.props
const compositeListId = createListId(fandomSlug, list.data.id)
const entryIds = flattenEntries(list.data.structure)
const totalEntries = entryIds.length

// Get fandom info
const fandoms = await getCollection('fandoms')
const fandom = fandoms.find((f) => f.data.id === fandomSlug)
const fandomName = fandom?.data.name ?? fandomSlug

// Get entries for this fandom
const allEntries = await getCollection('entries')
const fandomEntries = allEntries.filter((e) =>
  e.id.startsWith(fandomSlug + '/')
)

// Create a map of entry ID to entry data for quick lookup
const entryMap = new Map<string, EntryData>()
fandomEntries.forEach((entry) => {
  entryMap.set(entry.data.id, entry.data as EntryData)
})
---

<Layout title={`The Order | ${list.data.title}`}>
  <DbStatusBanner client:load />
  <Header />

  <main class="relative min-h-screen">
    {/* Background grid */}
    <div class="grid-pattern pointer-events-none absolute inset-0 opacity-30">
    </div>

    <div class="relative mx-auto max-w-4xl px-4 py-8">
      {/* Breadcrumb */}
      <nav
        aria-label="Breadcrumb"
        class="mb-6 flex items-center gap-2 font-mono text-xs tracking-wider"
      >
        <a
          href="/"
          class="text-[var(--muted-foreground)] transition-colors hover:text-[var(--accent)]"
          >ARCHIVES</a
        >
        <span class="text-[var(--cyan)]/50">→</span>
        <a
          href={`/fandom/${fandomSlug}`}
          class="text-[var(--muted-foreground)] transition-colors hover:text-[var(--accent)]"
        >
          {fandomName.toUpperCase()}
        </a>
        <span class="text-[var(--cyan)]/50">→</span>
        <span class="text-[var(--accent)]">{list.data.title.toUpperCase()}</span
        >
      </nav>

      {/* List Header */}
      <header class="mb-10">
        <div
          class="h-px bg-gradient-to-r from-[var(--cyan)]/30 via-transparent to-transparent"
        >
        </div>

        <div class="mt-6 flex items-start justify-between gap-4">
          <div>
            <p
              class="mb-2 font-mono text-[10px] tracking-[0.2em] text-[var(--cyan)]/60"
            >
              LIST.{list.data.id.toUpperCase().slice(0, 4)}
            </p>
            <h1
              class="font-serif text-3xl font-bold tracking-[0.1em] uppercase md:text-4xl"
            >
              {list.data.title}
            </h1>
          </div>
          <FavoriteButton
            client:visible
            type="list"
            itemId={compositeListId}
            fandomId={fandomSlug}
            variant="icon"
            className="mt-1"
          />
        </div>

        {
          list.data.description && (
            <p class="mt-4 max-w-2xl text-[var(--muted-foreground)]">
              {list.data.description}
            </p>
          )
        }

        <div
          class="mt-6 flex items-center gap-6 font-mono text-xs tracking-wider"
        >
          <span class="text-[var(--muted-foreground)]">
            <span class="text-[var(--accent)]">{totalEntries}</span>
            <span class="ml-1 opacity-60">ENTRIES</span>
          </span>
          {
            list.data.estimatedRuntime && (
              <>
                <span class="text-[var(--cyan)]/30">│</span>
                <span class="text-[var(--muted-foreground)]">
                  <span class="opacity-60">RUNTIME</span>
                  <span class="ml-1 text-[var(--accent)]">
                    {list.data.estimatedRuntime}
                  </span>
                </span>
              </>
            )
          }
        </div>

        <div
          class="mt-6 h-px bg-gradient-to-r from-[var(--magenta)]/30 via-transparent to-[var(--cyan)]/30"
        >
        </div>
      </header>

      {/* Progress Bar */}
      <div
        class="mb-10 rounded-lg border border-[var(--cyan)]/20 bg-[var(--background-elevated)] p-5"
      >
        <div
          class="mb-4 flex items-center gap-3 font-mono text-[10px] tracking-widest text-[var(--cyan)]/60"
        >
          <span
            class="bg-success/20 text-success size-1.5 animate-pulse rounded-full"
          ></span>
          <span>MISSION PROGRESS</span>
        </div>
        <ListProgressBar
          client:visible
          listId={compositeListId}
          entryIds={entryIds}
          fandomId={fandomSlug}
          showDetails={true}
        />
      </div>

      {/* List Content */}
      <section class="space-y-8">
        {
          list.data.structure.map((layer) => (
            <ListLayer
              layer={layer}
              entryMap={entryMap}
              fandomId={fandomSlug}
            />
          ))
        }
      </section>
    </div>
  </main>
</Layout>

---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/main.astro'
import Header from '@/components/navigation/Header.astro'
import DbStatusBanner from '@/components/status/DbStatusBanner'
import ListLayer from '@/components/lists/ListLayer.astro'
import ListProgressBar from '@/components/tracking/ListProgressBar'
import FavoriteButton from '@/components/favorites/FavoriteButton'
import {
  flattenEntries,
  createListId,
  type EntryData,
} from '@/lib/content-utils'

export async function getStaticPaths() {
  const lists = await getCollection('lists')

  return lists.map((list) => {
    // Extract fandom slug from the collection ID (e.g., "star-wars/lists/chronological")
    const fandomSlug = list.id.split('/')[0]

    return {
      params: {
        slug: fandomSlug,
        listId: list.data.id,
      },
      props: { list, fandomSlug },
    }
  })
}

const { list, fandomSlug } = Astro.props
const compositeListId = createListId(fandomSlug, list.data.id)
const entryIds = flattenEntries(list.data.structure)
const totalEntries = entryIds.length

// Get fandom info
const fandoms = await getCollection('fandoms')
const fandom = fandoms.find((f) => f.data.id === fandomSlug)
const fandomName = fandom?.data.name ?? fandomSlug

// Get entries for this fandom
const allEntries = await getCollection('entries')
const fandomEntries = allEntries.filter((e) =>
  e.id.startsWith(fandomSlug + '/')
)

// Create a map of entry ID to entry data for quick lookup
const entryMap = new Map<string, EntryData>()
fandomEntries.forEach((entry) => {
  entryMap.set(entry.data.id, entry.data as EntryData)
})
---

<Layout title={`The Order | ${list.data.title}`}>
  <DbStatusBanner client:load />
  <Header />

  <main class="mx-auto max-w-4xl px-4 py-8">
    {/* Breadcrumb */}
    <nav aria-label="Breadcrumb" class="text-muted-foreground mb-6 text-sm">
      <a href="/" class="hover:text-foreground transition-colors">Browse</a>
      <span class="mx-2">→</span>
      <a
        href={`/fandom/${fandomSlug}`}
        class="hover:text-foreground transition-colors"
      >
        {fandomName}
      </a>
      <span class="mx-2">→</span>
      <span class="text-foreground">{list.data.title}</span>
    </nav>

    {/* List Header */}
    <header class="mb-8">
      <div class="flex items-start justify-between gap-4">
        <h1 class="font-serif text-3xl font-semibold tracking-wider">
          {list.data.title}
        </h1>
        <FavoriteButton
          client:visible
          type="list"
          itemId={compositeListId}
          fandomId={fandomSlug}
          variant="icon"
          className="mt-1"
        />
      </div>
      {
        list.data.description && (
          <p class="text-muted-foreground mt-2">{list.data.description}</p>
        )
      }
      <div
        class="text-muted-foreground mt-4 flex items-center gap-4 font-mono text-sm"
      >
        <span>{totalEntries} entries</span>
        {
          list.data.estimatedRuntime && (
            <>
              <span>•</span>
              <span>{list.data.estimatedRuntime}</span>
            </>
          )
        }
      </div>
    </header>

    {/* Progress Bar */}
    <div class="bg-elevated mb-8 rounded-xl p-4">
      <ListProgressBar
        client:visible
        listId={compositeListId}
        entryIds={entryIds}
        fandomId={fandomSlug}
        showDetails={true}
      />
    </div>

    {/* List Content */}
    <section class="space-y-6">
      {
        list.data.structure.map((layer) => (
          <ListLayer layer={layer} entryMap={entryMap} fandomId={fandomSlug} />
        ))
      }
    </section>
  </main>
</Layout>

---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/main.astro'
import Header from '@/components/navigation/Header.astro'
import FandomCard from '@/components/cards/FandomCard.astro'
import DbStatusBanner from '@/components/status/DbStatusBanner'

// Get all fandoms at build time
const fandomsCollection = await getCollection('fandoms')

// Extract fandom data for rendering
const fandoms = fandomsCollection.map((f) => ({
  id: f.data.id,
  name: f.data.name,
  description: f.data.description,
}))
---

<Layout title="The Order | Browse Fandoms">
  <DbStatusBanner client:load />
  <Header currentPath="/" />

  <main class="relative min-h-screen">
    {/* Background grid pattern */}
    <div
      class="grid-pattern pointer-events-none absolute inset-0 opacity-50"
      aria-hidden="true"
    >
    </div>

    {/* Hero section */}
    <header class="relative py-10 text-center sm:py-16 md:py-24">
      {/* Decorative elements */}
      <div
        class="absolute top-6 left-1/2 h-px w-32 -translate-x-1/2 bg-gradient-to-r from-transparent via-[var(--cyan)] to-transparent opacity-30 sm:top-8 sm:w-48"
        aria-hidden="true"
      >
      </div>

      <div class="mx-auto max-w-2xl px-4">
        <p
          class="text-accent mb-3 font-mono text-[10px] tracking-[0.3em] uppercase sm:mb-4 sm:text-xs"
        >
          Canon Tracking System
        </p>
        <h1
          class="font-serif text-4xl font-bold tracking-[0.15em] uppercase sm:text-5xl md:text-7xl"
        >
          The Order
        </h1>
        <div
          class="mx-auto mt-4 h-px w-24 bg-gradient-to-r from-transparent via-[var(--magenta)] to-transparent sm:mt-6 sm:w-32"
        >
        </div>
        <p
          class="text-muted-foreground mt-4 text-base sm:mt-6 sm:text-lg md:text-xl"
        >
          Navigate your journey through legendary universes.
          <br />
          <span class="text-accent/80">Every story. In order.</span>
        </p>
      </div>

      <div
        class="absolute bottom-6 left-1/2 h-px w-32 -translate-x-1/2 bg-gradient-to-r from-transparent via-[var(--cyan)] to-transparent opacity-30 sm:bottom-8 sm:w-48"
        aria-hidden="true"
      >
      </div>
    </header>

    {/* Fandoms section */}
    <section class="relative mx-auto max-w-6xl px-3 pb-10 sm:px-4 sm:pb-16">
      <div class="mb-6 flex items-center gap-3 sm:mb-8 sm:gap-4">
        <div
          class="h-px flex-1 bg-gradient-to-r from-[var(--cyan)]/30 to-transparent"
        >
        </div>
        <h2
          class="text-muted-foreground font-mono text-[10px] tracking-[0.2em] uppercase sm:text-xs"
        >
          Available Archives
        </h2>
        <span class="text-accent font-mono text-[10px] sm:text-xs"
          >[{fandoms.length}]</span
        >
        <div
          class="h-px flex-1 bg-gradient-to-l from-[var(--cyan)]/30 to-transparent"
        >
        </div>
      </div>

      {
        fandoms.length === 0 ? (
          <div class="bg-elevated corner-marks rounded-lg p-8 text-center">
            <h2 class="font-mono text-lg font-semibold tracking-wide uppercase">
              No Archives Available
            </h2>
            <p class="text-muted-foreground mt-2 font-mono text-sm">
              System initializing. Check back later.
            </p>
          </div>
        ) : (
          <div class="grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
            {fandoms.map((fandom, index) => (
              <div
                class="animate-in fade-in slide-in-from-bottom-4"
                style={`animation-delay: ${index * 100}ms; animation-fill-mode: both;`}
              >
                <FandomCard
                  id={fandom.id}
                  name={fandom.name}
                  description={fandom.description}
                />
              </div>
            ))}
          </div>
        )
      }
    </section>
  </main>

  <footer class="border-border/30 relative border-t py-8 sm:py-12">
    <div
      class="absolute top-0 left-1/2 h-px w-24 -translate-x-1/2 bg-gradient-to-r from-transparent via-[var(--cyan)] to-transparent opacity-40 sm:w-32"
    >
    </div>
    <div class="text-center">
      <p
        class="text-muted-foreground font-mono text-[10px] tracking-widest sm:text-xs"
      >
        THE ORDER // CANON TRACKER // v1.0
      </p>
    </div>
  </footer>
</Layout>

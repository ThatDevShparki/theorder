---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/main.astro'
import Header from '@/components/navigation/Header.astro'
import FandomCard from '@/components/cards/FandomCard.astro'
import DbStatusBanner from '@/components/status/DbStatusBanner'

// Get all fandoms at build time
const fandomsCollection = await getCollection('fandoms')

// Extract fandom data for rendering
const fandoms = fandomsCollection.map((f) => ({
  id: f.data.id,
  name: f.data.name,
  description: f.data.description,
}))
---

<Layout title="The Order | Browse Fandoms">
  <DbStatusBanner client:load />
  <Header currentPath="/" />

  <main class="mx-auto max-w-6xl px-4 py-8">
    <header class="mb-8 text-center">
      <h1 class="font-serif text-4xl font-semibold tracking-wider md:text-5xl">
        The Order
      </h1>
      <p class="text-muted-foreground mt-3 text-lg">
        Track your journey through your favorite fandoms
      </p>
    </header>

    {
      fandoms.length === 0 ? (
        <div class="bg-elevated rounded-xl p-8 text-center">
          <h2 class="text-xl font-semibold">No fandoms yet</h2>
          <p class="text-muted-foreground mt-2">
            Content is coming soon. Check back later!
          </p>
        </div>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {fandoms.map((fandom) => (
            <FandomCard
              id={fandom.id}
              name={fandom.name}
              description={fandom.description}
            />
          ))}
        </div>
      )
    }
  </main>

  <footer
    class="border-border text-muted-foreground border-t py-8 text-center text-sm"
  >
    <p>Track your fandom journey with The Order</p>
  </footer>
</Layout>
